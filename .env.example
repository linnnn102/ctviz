# Optional: enables the LLM planner cascade. Without it the rule-based planner is used.
OPENAI_API_KEY=

# Planner cascade (defaults chosen by evals/run_eval.py; see evals/results/*/report.md)
CTVIZ_LLM_ENABLED=true
CTVIZ_PLANNER_MODEL=gpt-5-mini
CTVIZ_PLANNER_EFFORT=low
CTVIZ_ESCALATION_ENABLED=true
CTVIZ_ESCALATION_MODEL=gpt-5.4
CTVIZ_ESCALATION_EFFORT=medium
CTVIZ_LLM_TIMEOUT_S=60

# Data fetching
CTVIZ_DEFAULT_MAX_STUDIES=5000
CTGOV_TIMEOUT_S=30
CTGOV_CACHE_TTL_S=900
